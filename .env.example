# =============================================================================
#  AllConverter — Environment Configuration
#  Copy this file to .env and fill in the values for your environment.
#  NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
#  CORS
#  Comma-separated list of allowed origins.
#  In production set this to your exact domain(s) — never use "*".
#  In local development use your Vite dev-server address.
# -----------------------------------------------------------------------------

# --- PRODUCTION ---
CORS_ORIGINS=https://allconverter.emqnuele.dev

# --- LOCAL DEVELOPMENT (uncomment, comment out the line above) ---
# CORS_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
#  REVERSE PROXY (Render, Railway, Fly.io, Nginx, Caddy, …)
#  Set to true only when the app sits behind a trusted reverse proxy that
#  injects / sanitises the X-Forwarded-For / X-Real-IP headers.
#  This makes per-user rate limiting work correctly (VULN-10).
#  Leave false when running locally or behind an untrusted network.
# -----------------------------------------------------------------------------
TRUST_PROXY_HEADERS=true


# -----------------------------------------------------------------------------
#  INTERNAL API PROTECTION
#  The backend rejects /api/* calls that miss the X-Requested-With header.
#  Keep REQUIRE_INTERNAL_HEADER=true in production.
#  The frontend sends this header automatically — no manual action needed.
# -----------------------------------------------------------------------------
REQUIRE_INTERNAL_HEADER=true
INTERNAL_HEADER_VALUE=AllConverter


# -----------------------------------------------------------------------------
#  FILE LIMITS
#  Tune to your server capacity. On a small VPS lower MAX_FILE_SIZE and
#  MAX_WORKERS to avoid OOM kills.
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=314572800       # 300 MB in bytes  (300 * 1024 * 1024)
MAX_WORKERS=2                 # thread-pool workers for conversion tasks
MAX_FILES_PER_REQUEST=20      # max files per /convert call


# -----------------------------------------------------------------------------
#  SESSION LIFECYCLE
#  Converted files are deleted after SESSION_TTL_HOURS hours.
#  The cleanup loop runs every CLEANUP_INTERVAL_SECONDS seconds.
# -----------------------------------------------------------------------------
SESSION_TTL_HOURS=6.0
CLEANUP_INTERVAL_SECONDS=3600.0


# -----------------------------------------------------------------------------
#  STORAGE DIRECTORIES
#  Defaults are relative to the project root and work out of the box.
#  Override if you mount external volumes (e.g. a Docker volume or cloud disk).
# -----------------------------------------------------------------------------
# UPLOAD_DIR=/data/uploads
# CONVERTED_DIR=/data/converted
# FRONTEND_DIST=/app/frontend/dist


# -----------------------------------------------------------------------------
#  FFMPEG
#  USE_STATIC_FFMPEG=true  → the app downloads a static ffmpeg binary automatically
#                             (recommended for Render, Railway, and other PaaS).
#  USE_STATIC_FFMPEG=false → you manage ffmpeg yourself (installed in PATH).
#                             Use this in Docker images where you install ffmpeg
#                             via apt/apk to avoid re-downloading on every start.
# -----------------------------------------------------------------------------
USE_STATIC_FFMPEG=true


# -----------------------------------------------------------------------------
#  LOGGING
#  LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
#  Use INFO in production, DEBUG only during local dev.
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s │ %(levelname)-8s │ %(name)s │ %(message)s
